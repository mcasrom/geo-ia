</tr>
</thead>
<tbody>
<tr>
<td class="org-left"><b><b>Incompetencia (I)</b></b></td>
<td class="org-left">Falta de habilidades básicas</td>
<td class="org-left">x 2</td>
</tr>

<tr>
<td class="org-left"><b><b>Narcisismo (N)</b></b></td>
<td class="org-left">Obsesión por imagen personal</td>
<td class="org-left">x 3</td>
</tr>

<tr>
<td class="org-left"><b><b>Impaciencia (P)</b></b></td>
